rules_version = '2';

// Security Rules — Besuchsmorgen FMS Neufeld
//
// Diese Datei ist der einzige wirksame Schutz gegen Überbuchung und Manipulation.
// Das Bildschirmverhalten ist es ausdrücklich NICHT: Die App läuft im Browser des
// Gasts und kann dort verändert werden. Was hier steht, kann niemand umgehen.
//
// Wird bei jedem Push nach main automatisch deployt (.github/workflows/firebase.yml).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- Helfer

    function angemeldet() {
      return request.auth != null;                    // anonym genügt
    }

    function echteMail() {
      return angemeldet()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    // Erstzugang: diese Adressen dürfen sich selbst als Administration eintragen. Ohne
    // das käme niemand hinein, um die ersten Zugänge zu vergeben — Henne und Ei.
    function bootstrapMail() {
      return echteMail() && request.auth.token.email in ['alain.sc2@gmail.com'];
    }

    // Einladungen liegen unter der Mailadresse, weil es die Person beim Einladen noch
    // gar nicht gibt: Eine uid entsteht erst beim ersten Anmelden.
    function mailSchluessel() { return request.auth.token.email.lower(); }

    function eingeladen() {
      return echteMail()
        && exists(/databases/$(database)/documents/zugang/$(mailSchluessel()));
    }

    function einladungsRolle() {
      return get(/databases/$(database)/documents/zugang/$(mailSchluessel())).data.rolle;
    }

    /**
     * Zwei Rollen (Entscheid: Steuerung nicht für alle).
     * `betreuung` sieht die Übersicht und erfasst Anmeldungen für Gäste ohne Handy.
     * `admin` darf zusätzlich steuern: Freigabeschalter, Kapazitäten, Zurücksetzen,
     * und Zugänge vergeben. Fehlt einem alten Dokument das Feld, gilt die kleinere Rolle.
     */
    function istBetreuung() {
      return angemeldet()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function istAdmin() {
      return istBetreuung()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid))
             .data.get('rolle', 'betreuung') == 'admin';
    }

    // Harte Decke aus Entscheid D3. config/app.maxPlaetzeProGeraet ist zur Laufzeit
    // auf 1–4 einstellbar; diese Konstante kann niemand überschreiten.
    function maxPlaetze() { return 4; }

    // Entscheid D4: manueller Freigabeschalter. Wird nur beim Schreiben der Buchung
    // geprüft — jede Buchung fasst dieses Dokument an, also blockiert das die ganze
    // Transaktion. Spart zwei get() je Buchung gegenüber einer Prüfung auf slots.
    function anmeldungOffen() {
      return get(/databases/$(database)/documents/config/app).data.anmeldungOffen == true;
    }

    function nurGeaendert(felder) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(felder);
    }

    function gueltigePlaetze(n) {
      return n is int && n >= 1 && n <= maxPlaetze();
    }

    // Kapazität je Block, gespiegelt aus data/programm.json: Ateliers 35, Lektionen 20.
    // Wird nur für die Selbstheilung unten gebraucht — siehe dort, warum das nötig ist.
    function blockKapazitaet(block) {
      return block in ['a1', 'a2'] ? 35 : 20;
    }

    function keineWahl(d) {
      return d.wahl.get('a1', null) == null && d.wahl.get('a2', null) == null
        && d.wahl.get('l1', null) == null && d.wahl.get('l2', null) == null;
    }

    // Die Wahl ist der einzige Ort, an dem ein Gast frei formulierten Inhalt schreibt.
    // Ohne Prüfung nahm der Server jeden Unsinn an: eine Angebots-ID, die es nicht gibt
    // (die Betreuungsliste zeigt dann eine leere Zeile), fremde Blockschlüssel, oder eine
    // riesige Zeichenkette. Struktur lässt sich hier billig erzwingen — die Angebots-ID
    // muss zum Block passen, so wie bei den Zählern auch.
    function gueltigerSlot(wert, blk) {
      return wert == null || (wert is string && wert.size() <= 60 && wert.matches(blk + '-.+'));
    }

    function gueltigeWahl(d) {
      return d.wahl is map
        && d.wahl.keys().hasOnly(['a1', 'a2', 'l1', 'l2'])
        && gueltigerSlot(d.wahl.get('a1', null), 'a1')
        && gueltigerSlot(d.wahl.get('a2', null), 'a2')
        && gueltigerSlot(d.wahl.get('l1', null), 'l1')
        && gueltigerSlot(d.wahl.get('l2', null), 'l2');
    }

    // Die Notiz schreibt nur die Betreuung («3 SuS ohne Handy»). Ohne Obergrenze passt
    // dort ein Dokument von fast einem Megabyte hinein — und jede Betreuungsperson lädt
    // die ganze Buchungsliste live mit.
    function gueltigeNotiz(d) {
      return d.notiz == null || (d.notiz is string && d.notiz.size() <= 300);
    }

    function gueltigeBuchung(d) {
      return gueltigeWahl(d) && gueltigeNotiz(d);
    }

    // ------------------------------------------------- log: Protokollzeilen

    function protokollFelder() {
      return ['zeitpunkt', 'client', 'art', 'geraet', 'vorgang', 'block', 'angebot',
              'vorher', 'plaetze', 'slots'];
    }

    /**
     * Eine Protokollzeile ist eng geschnürt: exakt diese zehn Felder, jedes mit Typ und
     * Obergrenze. Sie ist die einzige Sammlung, in die ein Gast BELIEBIG viele Dokumente
     * legen kann — bei `bookings` und `slots` ist die Dokument-ID vorgegeben. Ohne diese
     * Prüfung wäre sie der bequemste Ort, um die Datenbank vollzuschreiben.
     *
     * `zeitpunkt == request.time` erzwingt die Serverzeit: Ein Protokoll, in dem der
     * Client seine eigene Uhr einträgt, taugt nicht als Nachweis.
     */
    function gueltigesProtokoll(d) {
      return d.keys().hasOnly(protokollFelder())
        && d.keys().hasAll(protokollFelder())
        && d.zeitpunkt == request.time
        && d.client is string && d.client.size() <= 64
        && d.art in ['gast', 'admin']
        && d.geraet is string && d.geraet.size() <= 40
        && d.vorgang in ['gebucht', 'gewechselt', 'freigegeben', 'erfasst']
        && (d.block == null || d.block in ['a1', 'a2', 'l1', 'l2'])
        && (d.angebot == null || (d.angebot is string && d.angebot.size() <= 60))
        && (d.vorher == null || (d.vorher is string && d.vorher.size() <= 60))
        && gueltigePlaetze(d.plaetze)
        // Höchstens die vier Blöcke — mehr Slots kann eine Anmeldung gar nicht halten.
        && d.slots is int && d.slots >= 0 && d.slots <= 4;
    }

    // ------------------------------------------------------ config: Steuerung

    match /config/{dok} {
      allow read: if true;                             // jedes Gerät liest den Zustand
      allow write: if istAdmin();
    }

    // ------------------------------------------------- zugang: Einladungen

    // Dokument-ID ist die Mailadresse in Kleinbuchstaben.
    match /zugang/{mail} {
      // Die eigene Einladung darf man lesen — daraus erfährt die App die eigene Rolle.
      allow get:  if istAdmin() || (echteMail() && mailSchluessel() == mail);
      allow list: if istAdmin();
      allow write: if istAdmin();
    }

    // ------------------------------- admins: freigeschaltete Betreuungspersonen

    match /admins/{uid} {
      allow get:  if angemeldet() && (request.auth.uid == uid || istBetreuung());
      allow list: if istAdmin();

      // Selbstfreischaltung beim ersten Anmelden — aber nur mit genau der Rolle, die in
      // der Einladung steht. Eine Betreuungsperson kann sich so nicht selbst befördern.
      allow create: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['rolle', 'name', 'email', 'seit'])
        && request.resource.data.rolle in ['admin', 'betreuung']
        && ((eingeladen() && request.resource.data.rolle == einladungsRolle())
            || (bootstrapMail() && request.resource.data.rolle == 'admin'));

      // Der Erstzugang darf sein eigenes Dokument reparieren (etwa eine fehlende Rolle
      // nachtragen) — sonst sperrt eine unvollständige Altlast die Administration aus.
      allow update: if istAdmin()
        || (request.auth.uid == uid && bootstrapMail() && request.resource.data.rolle == 'admin');

      allow delete: if istAdmin();
    }

    // ---------------------------------------------------------- slots: Zähler

    match /slots/{slotId} {
      allow read: if true;

      // Der Normalfall: Gäste verschieben ausschliesslich `belegt`, nie über die
      // Kapazität hinaus und nie um mehr als eine Gruppengrösse auf einmal.
      // Damit ist Überbuchung serverseitig unmöglich — auch bei manipuliertem Client.
      allow update: if angemeldet()
        && nurGeaendert(['belegt'])
        && request.resource.data.belegt is int
        && request.resource.data.belegt >= 0
        && request.resource.data.belegt <= resource.data.kapazitaet
        && math.abs(request.resource.data.belegt - resource.data.belegt) <= maxPlaetze();

      // Selbstheilung, falls ein Zählerdokument fehlt (noch nicht eingespielt).
      // Streng begrenzt: Der Blockschlüssel muss zur Angebots-ID passen UND die Kapazität
      // zum Block. Sonst könnte ein manipulierter Client einem 20er-Zimmer 35 Plätze
      // verpassen, indem er den fehlenden Zähler selbst anlegt.
      allow create: if angemeldet()
        && request.resource.data.keys().hasOnly(['belegt', 'kapazitaet', 'block'])
        && request.resource.data.block in ['a1', 'a2', 'l1', 'l2']
        && slotId.matches(request.resource.data.block + '-.+')
        && request.resource.data.kapazitaet == blockKapazitaet(request.resource.data.block)
        && request.resource.data.belegt is int
        && request.resource.data.belegt >= 0
        && request.resource.data.belegt <= maxPlaetze();

      // Kapazitäten anpassen, einspielen und zurücksetzen ist Sache der Administration.
      allow write: if istAdmin();
    }

    // ---------------------------------------------------- bookings: Anmeldung

    match /bookings/{buchungId} {

      allow get:  if request.auth.uid == buchungId || istBetreuung();
      allow list: if istBetreuung();      // nur die Betreuung sieht alle Anmeldungen

      allow create: if (angemeldet()
          && request.auth.uid == buchungId
          && anmeldungOffen()
          && request.resource.data.keys().hasOnly(
               ['plaetze', 'wahl', 'quelle', 'notiz', 'erstelltAm', 'geaendertAm'])
          && gueltigePlaetze(request.resource.data.plaetze)
          && gueltigeBuchung(request.resource.data)
          && request.resource.data.quelle == 'gast')
        // Betreuung erfasst Anmeldungen für Gäste ohne Handy (eigene Dokument-ID).
        // Bewusst ohne anmeldungOffen(): Am Info-Stand muss das auch nach Schluss gehen.
        || (istBetreuung()
          && request.resource.data.keys().hasOnly(
               ['plaetze', 'wahl', 'quelle', 'notiz', 'erstelltAm', 'geaendertAm'])
          && gueltigePlaetze(request.resource.data.plaetze)
          && gueltigeBuchung(request.resource.data)
          && request.resource.data.quelle == 'admin');

      allow update: if (angemeldet()
          && request.auth.uid == buchungId
          && anmeldungOffen()
          && request.resource.data.quelle == resource.data.quelle
          && gueltigeBuchung(request.resource.data)
          // Gruppengrösse nur ändern, solange noch nichts gebucht ist
          && (request.resource.data.plaetze == resource.data.plaetze
              || (keineWahl(resource.data) && gueltigePlaetze(request.resource.data.plaetze))))
        || istAdmin();

      // Fremde Anmeldungen löschen gehört zum Aufräumen — also zur Administration.
      allow delete: if request.auth.uid == buchungId || istAdmin();
    }

    // ------------------------------------------------------- log: Protokoll

    /**
     * Wer wann welchen Vorgang ausgelöst hat — die Grundlage des Protokollbereichs in
     * der Steuerung. Angeschrieben wird EINMAL: `update` ist für alle gesperrt, auch für
     * die Administration. Ein Protokoll, das sich nachträglich ändern lässt, beweist
     * nichts. Aufräumen (nach der Generalprobe, nach dem Event) heisst deshalb löschen.
     */
    match /log/{eintragId} {
      allow get, list: if istBetreuung();

      allow create: if (angemeldet()
          // Ein Gast protokolliert ausschliesslich seinen eigenen Vorgang — die
          // Client-Kennung MUSS seine uid sein, sonst liessen sich fremde Zeilen erfinden.
          && request.auth.uid == request.resource.data.client
          && request.resource.data.art == 'gast'
          // Dieselbe Bedingung wie für die Buchung selbst: Ist die Anmeldung zu, gibt es
          // auch nichts zu protokollieren. Das schliesst die Sammlung ausserhalb des
          // Anlasses zu — sie ist die einzige mit frei wählbarer Dokument-ID.
          && anmeldungOffen()
          && gueltigesProtokoll(request.resource.data))
        // Am Info-Stand erfasste Anmeldungen tragen die Buchungs-ID als Client, nicht die
        // uid der Betreuungsperson: Protokolliert wird der Vorgang, nicht wer tippt.
        || (istBetreuung()
          && request.resource.data.art == 'admin'
          && gueltigesProtokoll(request.resource.data));

      allow update: if false;
      allow delete: if istAdmin();
    }

    // ------------------------------------------------------------ alles Übrige

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
