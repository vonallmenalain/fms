# .env.local (lokal)  bzw. Netlify -> Site settings -> Environment variables
# Diese Werte sind KEINE Geheimnisse: die Firebase-Web-Konfiguration ist
# öffentlich, der Schutz kommt vollständig aus firestore.rules.

VITE_FIREBASE_API_KEY=...
VITE_FIREBASE_AUTH_DOMAIN=fms-besuchstag-test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fms-besuchstag-test
VITE_FIREBASE_APP_ID=...

# In Netlify pro Kontext setzen:
#   Production  -> fms-besuchstag-prod
#   Deploy preview / Branch deploys -> fms-besuchstag-test
